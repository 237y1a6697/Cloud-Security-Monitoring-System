# Production environment — used by Vercel during `vite build`
# ⚠️  Also set VITE_API_URL in Vercel Dashboard → Project Settings → Environment Variables
#     so that Vercel re-builds with this value on every deployment.
#
# No trailing slash. Must be the exact Render service URL.
VITE_API_URL=https://sentinelcore-backend.onrender.com
